# Default = local, no config needed. Copy to .env and uncomment to override.

# CURSOR_TEAM_PORT=7777
# CURSOR_TEAM_TEAM_ID=cursor_team
# CURSOR_TEAM_DEFAULT_MODEL=composer-2.5
# CURSOR_TEAM_DEFAULT_MODE=ask
# CURSOR_TEAM_BASE_SPAWN_CMD=cursor-agent
# CURSOR_TEAM_WORKER_FALLBACK_LOCAL=false

# Log each Cursor ACP prompt/response with recipient (leader, researcher, coder, writer)
# CURSOR_TEAM_ACP_TRACE=true
# CURSOR_TEAM_ACP_TRACE_COLOR=1

# Library harness (generic apps): AGNO_CURSOR_ACP_TRACE, AGNO_CURSOR_BASE_SPAWN_CMD, etc.

# Per-role model defaults (JSON map role -> model id)
# CURSOR_TEAM_ROLE_MODELS={"leader":"auto","coder":"composer-2.5","writer":"claude-sonnet-5-5-medium","product_owner":"claude-sonnet-5-5-medium"}

# Per-agent overrides (JSON map agent_id -> {model, mode, worker_url})
# CURSOR_TEAM_AGENTS={"researcher":{"worker_url":"http://localhost:7801"}}

# Shorthand scalar maps (JSON)
# CURSOR_TEAM_WORKERS={"researcher":"http://localhost:7801","writer":"http://localhost:7802"}
# CURSOR_TEAM_MODELS={"leader":"gpt-5.5-high"}
# CURSOR_TEAM_MODES={"writer":"agent"}

# Tests integration target
# TEAM_BASE_URL=http://localhost:7777

# Cursor CLI login is required to run the demo (cursor-agent login).
# Users may set CURSOR_API_KEY in their own environment per Cursor docs — do not commit secrets.
